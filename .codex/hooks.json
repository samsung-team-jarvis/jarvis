{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(git rev-parse --show-toplevel 2>/dev/null)/scripts/agent_guard.py\"; [ ! -f \"$f\" ] || python3 \"$f\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
